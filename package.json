{
  "name": "@hexlabelposition/som",
  "version": "0.1.0",
  "description": "Zero-dependency, tree-shakeable ESM toolkit for working with SVG as plain objects.",
  "keywords": [
    "svg",
    "ast",
    "parser",
    "serializer",
    "xml"
  ],
  "homepage": "https://github.com/hexlabelposition/som#readme",
  "bugs": "https://github.com/hexlabelposition/som/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexlabelposition/som.git"
  },
  "license": "MIT",
  "author": "Vladyslav Kudriashov",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.0",
  "scripts": {
    "build": "tsdown",
    "prepack": "bun run build",
    "typecheck": "tsc -p tsconfig.lib.json && tsc -p tsconfig.test.json && tsc -p tsconfig.scripts.json",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check . '!**/*.md'",
    "docs:check": "prettier --check '**/*.md'",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "test:webkit": "sh scripts/test-webkit.sh",
    "bench": "bun run build && vitest bench --run --config vitest.bench.config.ts --reporter=verbose",
    "bench:bun": "bun --bun run bench",
    "spec:generate": "bun scripts/generate-spec/index.ts",
    "spec:check": "bun scripts/generate-spec/index.ts --check",
    "check": "bun run lint && bun run format:check && bun run docs:check && bun run typecheck && bun run spec:check && bun run test:node && bun run test:browser --browser chromium && bun run test:browser --browser firefox && bun run build && npm pack --dry-run"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@mdn/browser-compat-data": "8.1.7",
    "@tabler/icons": "3.49.0",
    "@types/node": "^22.20.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@webref/css": "8.7.8",
    "@webref/elements": "2.9.2",
    "@webref/idl": "3.86.0",
    "bootstrap-icons": "1.13.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.3.0",
    "fast-check": "^4.10.2",
    "jiti": "^2.7.0",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "simple-icons": "16.35.0",
    "svg-parser": "2.1.0",
    "svgson": "5.3.1",
    "tsdown": "^0.23.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "webidl2": "24.5.0"
  }
}
